{
  "manifest_version": 3,
  "name": "BedReady — 3MF Converter",
  "version": "0.6.1",
  "description": "__MSG_description__",
  "default_locale": "en",
  "homepage_url": "https://bedready.io/extension",
  "permissions": [
    "downloads",
    "notifications",
    "storage"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://makerworld.com/*",
    "https://*.makerworld.com/*",
    "https://*.bblmw.com/*",
    "https://www.printables.com/*",
    "https://*.printables.com/*",
    "https://www.thingiverse.com/*",
    "https://*.thingiverse.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://bedready.io/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://makerworld.com/*",
        "https://*.makerworld.com/*",
        "https://www.printables.com/*",
        "https://www.thingiverse.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
