// The U1 reference profile's four filament slots are Snapmaker's "Generic ABS". A converted slot named
// "Generic PLA" kept ABS's 270 °C nozzle, 90 °C bed and 10–80 % fan until 2026-10-23 — proven by
// converting a Prusa file declaring PLA at 215 °C. These pin the fix through the real converter.
import { test } from "node:test";
import assert from "node:assert/strict";
import { zipSync, unzipSync, strToU8, strFromU8 } from "fflate";
import { cleanThreeMF } from "./convert.ts";
import { U1_FILAMENT_PRESETS, u1FilamentPreset } from "./u1-filament-presets.ts";
import { RETARGET_MACHINES, u1NozzleVariant } from "./targets.ts";
import u1Profile from "./u1-profile.json" with { type: "json" };

const ref = u1Profile as Record<string, unknown>;
const MESH = `<vertices><vertex x="0" y="0" z="0"/><vertex x="1" y="0" z="0"/><vertex x="0" y="1" z="0"/></vertices><triangles><triangle v1="0" v2="1" v3="2"/></triangles>`;
const model = `<?xml version="1.0"?><model><resources><object id="1"><mesh>${MESH}</mesh></object></resources><build><item objectid="1" transform="1 0 0 0 1 0 0 0 1 128 128 0"/></build></model>`;
const file3mf = (entries: Record<string, string>) =>
  new File([zipSync(Object.fromEntries(Object.entries(entries).map(([k, v]) => [k, strToU8(v)])), { level: 0 }) as BlobPart], "t.3mf");
const prusa = (types: string) =>
  file3mf({ "Metadata/Slic3r_PE.config": `; generated by PrusaSlicer\n; filament_colour = #FF0000\n; filament_type = ${types}\n`, "3D/3dmodel.model": model });
async function cfgOf(blob: Blob): Promise<Record<string, string[]>> {
  const e = unzipSync(new Uint8Array(await blob.arrayBuffer()));
  return JSON.parse(strFromU8(e["Metadata/project_settings.config"]));
}

test("the reference really is Generic ABS: the ABS entry differs from it in nothing", () => {
  assert.deepEqual(U1_FILAMENT_PRESETS.ABS, {});
});

test("every preset key is a 4-slot array in the reference, so applying it can only overwrite a slot", () => {
  for (const [t, preset] of Object.entries(U1_FILAMENT_PRESETS))
    for (const k of Object.keys(preset)) assert.ok(Array.isArray(ref[k]) && (ref[k] as unknown[]).length === 4, `${t}.${k}`);
});

test("a PLA source with no slicer settings converts to PLA values, not the reference's ABS ones", async () => {
  for (const mode of ["preserve", "stamp"] as const) {
    const c = await cfgOf((await cleanThreeMF(prusa("PLA"), "u1", { mode })).blob);
    assert.equal(c.filament_settings_id[0], "Generic PLA", mode);
    assert.equal(c.nozzle_temperature[0], "220", `${mode}: was 270`);
    assert.equal(c.nozzle_temperature_initial_layer[0], "220", mode);
    assert.equal(c.hot_plate_temp[0], "65", `${mode}: was 90`);
    assert.equal(c.textured_plate_temp[0], "65", mode);
    assert.equal(c.fan_min_speed[0], "100", `${mode}: was 10`);
    if (mode === "stamp") {
      // A stamped slot is entirely the preset's, range included. Preserve mode keeps the reference's
      // range on purpose: it is the clamp ceiling for the creator's own temperatures (convert.test).
      assert.equal(c.nozzle_temperature_range_low[0], "190");
      assert.equal(c.nozzle_temperature_range_high[0], "240");
    }
  }
});

test("slots the source says nothing about take its first material, not ABS", async () => {
  const c = await cfgOf((await cleanThreeMF(prusa("PLA"), "u1", { mode: "stamp" })).blob);
  assert.deepEqual(c.filament_type, ["PLA", "PLA", "PLA", "PLA"]);
  assert.deepEqual(c.filament_settings_id, ["Generic PLA", "Generic PLA", "Generic PLA", "Generic PLA"]);
  assert.deepEqual(c.nozzle_temperature, ["220", "220", "220", "220"]);
});

test("each slot takes its own material", async () => {
  const c = await cfgOf((await cleanThreeMF(prusa("PLA;PETG;TPU;ABS"), "u1", { mode: "stamp" })).blob);
  assert.deepEqual(c.filament_type, ["PLA", "PETG", "TPU", "ABS"]);
  assert.deepEqual(c.nozzle_temperature, ["220", U1_FILAMENT_PRESETS.PETG.nozzle_temperature, U1_FILAMENT_PRESETS.TPU.nozzle_temperature, "270"]);
});

test("U1 nozzle variants get the same per-material values", async () => {
  const c = await cfgOf((await cleanThreeMF(prusa("PLA"), "u1", { mode: "stamp", machine: u1NozzleVariant(0.6) })).blob);
  assert.equal(c.nozzle_temperature[0], "220");
});

test("material lookup: exact type, then family; an unknown family is left alone", () => {
  assert.equal(u1FilamentPreset("PETG-CF"), U1_FILAMENT_PRESETS["PETG-CF"]);
  assert.equal(u1FilamentPreset("PLA+"), U1_FILAMENT_PRESETS.PLA);
  assert.equal(u1FilamentPreset("pla silk"), U1_FILAMENT_PRESETS.PLA);
  assert.equal(u1FilamentPreset("PEEK"), null);
  assert.equal(u1FilamentPreset(undefined), null);
});

test("the presets describe the U1 reference only — no other machine is built from it", () => {
  // Retarget machines carry no reference profile, so nothing here may assume they share U1's slots.
  for (const m of RETARGET_MACHINES) assert.ok(!m.id.startsWith("u1"), m.id);
});
